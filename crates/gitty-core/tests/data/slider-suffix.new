#!/bin/sh
# synthetic test script: repeated blocks with identical tails

. ./lib.sh

check 'archive entry 1' '
	run archive HEAD >out1.tar &&
	list out1.tar >actual &&
	cat >expect <<-\EOF &&
	dir1/
	dir1/file1
	EOF
	compare expect actual
'

